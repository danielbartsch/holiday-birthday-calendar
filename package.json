{
  "name": "calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "BROWSER=firefox vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "tsc"
  },
  "dependencies": {
    "react": "^16.13.1",
    "react-dom": "^16.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^16.9.0",
    "@types/react-dom": "^16.9.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^2.0.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "prettier": {
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid"
  }
}
